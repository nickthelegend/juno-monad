# Juno indexer — copy to `.env` for local runs (`pnpm dev` loads it), or set the
# same names in Envio Cloud → Settings → Environment Variables.
# Envio only passes through variables prefixed with ENVIO_.

# HyperSync access. Create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=<YOUR-API-TOKEN>
# No token? Index straight from the RPC instead: set this to "sync".
# ENVIO_TESTNET_RPC_FOR=sync

# --- Monad testnet (10143) -------------------------------------------------
# The JunoLaunchpad address (NEXT_PUBLIC_JUNO_LAUNCHPAD in the app).
ENVIO_JUNO_TESTNET_LAUNCHPAD=0x0000000000000000000000000000000000000000
# Its deployment block (JUNO_LAUNCHPAD_DEPLOY_BLOCK in the app). Must not be
# later than the deployment: the constructor's events set the fee split and the
# native quote. 0 also works (HyperSync skips empty ranges), just slower.
ENVIO_JUNO_TESTNET_START_BLOCK=0
# The Kuru graduator (JUNO_KURU_GRADUATOR in the app; deploy.sh prints it).
# Leave at zero if the deployment has no Kuru venue.
ENVIO_JUNO_TESTNET_KURU_GRADUATOR=0x0000000000000000000000000000000000000000

# --- Monad mainnet (143) ---------------------------------------------------
# Skipped by default. Set to false once a mainnet launchpad exists.
ENVIO_JUNO_SKIP_MAINNET=true
ENVIO_JUNO_MAINNET_LAUNCHPAD=0x0000000000000000000000000000000000000000
ENVIO_JUNO_MAINNET_START_BLOCK=0

# --- Optional --------------------------------------------------------------
# Only used to read decimals() of a quote token that is neither MON nor USDC.
# Defaults to the public endpoints.
# ENVIO_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# ENVIO_MONAD_RPC_URL=https://rpc.monad.xyz
