# Juno — server environment. Copy to .env.local and fill in.
# Nothing here is a secret except where marked SECRET.

# ─── Network ────────────────────────────────────────────────────────────────
# testnet (chain 10143, the default) or mainnet (chain 143).
NEXT_PUBLIC_MONAD_NETWORK=testnet
# A dedicated RPC (Alchemy, QuickNode, Dwellir…). Optional — falls back to the
# public endpoint, which caps eth_getLogs at 100 blocks and rate-limits bursts.
# May contain an API key: server-side only, never sent to the app.
MONAD_RPC_URL=
# The RPC the app is told to use for reads, if any. Must not contain a key.
NEXT_PUBLIC_MONAD_RPC_URL=
# Blocks per eth_getLogs for the trade log tail. 100 on the public RPC;
# raise it to what your dedicated RPC allows (e.g. 1000 on Alchemy).
JUNO_LOG_RANGE=100

# ─── Contracts (printed by contracts/deploy.sh) ─────────────────────────────
NEXT_PUBLIC_JUNO_LAUNCHPAD=
# The launchpad's deploy block — where the trade log tail starts.
JUNO_LAUNCHPAD_DEPLOY_BLOCK=
# Only if the launchpad allows a USDC other than Circle's canonical one.
NEXT_PUBLIC_JUNO_USDC=
# The Kuru graduator (testnet): lets a launch graduate into its own Kuru
# order-book market, and the app trade it there afterwards. Leave empty to
# offer Uniswap v2 only.
JUNO_KURU_GRADUATOR=
# JunoSwapRouter, from the same deploy: trades a coin after it graduates into
# its Uniswap v2 pair. Leave empty and graduated coins link to their pair only.
JUNO_SWAP_ROUTER=

# ─── Indexer (optional, recommended) ────────────────────────────────────────
# The GraphQL endpoint of the Envio HyperIndex deployment in indexer/.
# When set, full trade history comes from the indexer instead of the log tail.
ENVIO_GRAPHQL_URL=

# ─── Privy (optional) ──────────────────────────────────────────────────────
# Web sign-in with email, Google or X, and an embedded wallet that signs. The
# app id is public; the web build also needs it as EXPO_PUBLIC_PRIVY_APP_ID.
# The secret lets the server verify a Privy session and read the X account
# linked to it (POST /api/juno/profiles/privy). SECRET.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ─── Oracles ────────────────────────────────────────────────────────────────
# MON/USD comes from Pyth's contract on Monad and needs no key. Equity marks
# (the NAV band on stock trackers) are not pushed to Monad; with a Hermes key
# they are read fresh and scripts/pyth-push.ts can post them on-chain.
PYTH_API_KEY=
PYTH_HERMES_URL=https://hermes.pyth.network

# ─── Storage ────────────────────────────────────────────────────────────────
# Postgres: pools, posts, trades, follows, plans, watchlist. SECRET.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Mongo: comments, likes, names, the sealed faucet key. SECRET.
MONGODB_URI=
MONGODB_DB=juno
# IPFS pinning for media and token metadata. SECRET.
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# ─── Faucet (testnet only) ──────────────────────────────────────────────────
# Seals the faucet's private key at rest. SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JUNO_KEY_SECRET=
# MON sent per request. The faucet keeps Monad's 10 MON reserve for itself.
FAUCET_AMOUNT_MON=0.5

# ─── Deployment ─────────────────────────────────────────────────────────────
# The Expo web build. When set, page requests to this server redirect there.
JUNO_APP_URL=
# Base URL the CLI scripts post to (scripts/juno-launch.ts, juno-seed-posts.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── CLI scripts ────────────────────────────────────────────────────────────
# A funded testnet key for npm run juno:* — or leave empty and the scripts
# create one in .juno/ and print its address to fund. SECRET.
JUNO_SCRIPT_PRIVATE_KEY=
