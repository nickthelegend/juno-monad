# The lockfile was resolved with peer conflicts left as warnings: TypeScript 6
# is the app's own, while @solana/kit (pulled in through Privy and Coinbase's
# SDKs) still lists TypeScript ^5 as an optional peer. A strict `npm ci` — CI's
# npm 10 — refuses that tree with ERESOLVE; this makes every install the same.
legacy-peer-deps=true
