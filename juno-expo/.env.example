# Copy to .env. Both are optional for local development, and both must be set
# for a deployed build — eas.json deliberately leaves them empty, so pass them
# as EAS environment variables (or export them before `expo export`). See the
# repo root's DEPLOY.md.

# The Juno API (the Next.js app at the repo root). Unset, the app uses the
# machine Metro is served from on port 3000, which is right for `npm run dev`
# at the repo root.
# EXPO_PUBLIC_API_URL=https://your-juno-api.example.com

# Where shared links open. Unset, links use the API host, which redirects.
# EXPO_PUBLIC_APP_URL=https://your-juno-app.example.com
